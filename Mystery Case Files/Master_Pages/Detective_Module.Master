<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Detective_Module.Master.cs"
    Inherits="Mystery_Case_Files.Master_Pages.Detective_Master" %>

<!DOCTYPE html>

<html lang="en">

<head runat="server">

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">
            Mysterious Case Files
        </asp:ContentPlaceHolder>
    </title>

    <!-- GOOGLE FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
        rel="stylesheet" />

    <!-- FONT AWESOME -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- MASTER CSS -->
    <link href="../CSS/Master/Detective_Module.css?v=2"
        rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

</head>

<body class="detective-module-page">

    <form id="form1" runat="server">

        <div class="dm-background"></div>
        <div class="dm-background-overlay"></div>

        <div class="dm-shell">

            <!-- =====================================
                 HEADER
            ====================================== -->

            <header class="dm-header">

                <!-- LOGO -->
                <a href="<%= ResolveUrl("~/Detective_Module/Home_Detective.aspx") %>"
                    class="dm-logo">

                    <div class="dm-logo-icon">
                        <i class="fa-solid fa-user-secret"></i>
                    </div>

                </a>


                <!-- CENTER BRAND -->
                <div class="dm-brand">

                    <h1>MYSTERIOUS CASE FILES</h1>

                    <span>DETECTIVE UNIT</span>

                    <div class="dm-brand-line"></div>

                </div>


                <!-- SYSTEM STATUS -->
                <div class="dm-header-status">

                    <span class="dm-status-indicator"></span>

                    <div class="dm-status-text">

                        <span class="dm-status-label">
                            INVESTIGATION SYSTEM
                        </span>

                        <span class="dm-status-value">
                            OPERATIONAL
                        </span>

                    </div>

                </div>

            </header>


            <!-- =====================================
                 WORKSPACE
            ====================================== -->

            <div class="dm-workspace">


                <!-- =================================
                     LEFT SIDEBAR
                ================================== -->

                <aside class="dm-sidebar">


                    <!-- SIDEBAR HEADING -->
                    <div class="dm-sidebar-heading">

                        <span class="dm-sidebar-caption">
                            INVESTIGATION
                        </span>

                        <h3>MAIN MENU</h3>

                    </div>


                    <!-- NAVIGATION LINKS -->
                    <nav class="dm-sidebar-nav">

                        <a href="<%= ResolveUrl("~/Detective_Module/Dashboard_Detective.aspx") %>"
                            class="dm-nav-link">

                            <i class="fa-solid fa-gauge-high"></i>

                            <span>Dashboard</span>

                            <i class="fa-solid fa-angle-right dm-nav-arrow"></i>

                        </a>


                        <a href="<%= ResolveUrl("~/Detective_Module/AddNew_Detective.aspx") %>"
                            class="dm-nav-link">

                            <i class="fa-solid fa-user-plus"></i>

                            <span>Register Detective</span>

                            <i class="fa-solid fa-angle-right dm-nav-arrow"></i>

                        </a>


                        <a href="<%= ResolveUrl("~/Detective_Module/Search_Detective.aspx") %>"
                            class="dm-nav-link">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            <span>Search Detective</span>

                            <i class="fa-solid fa-angle-right dm-nav-arrow"></i>

                        </a>


                        <a href="<%= ResolveUrl("~/Detective_Module/All_Detective.aspx") %>"
                            class="dm-nav-link">

                            <i class="fa-solid fa-address-book"></i>

                            <span>Detective Directory</span>

                            <i class="fa-solid fa-angle-right dm-nav-arrow"></i>

                        </a>

                    </nav>


                    <!-- SIDEBAR DIVIDER -->
                    <div class="dm-sidebar-divider"></div>


                    <!-- FIELD NOTES -->
                    <div class="dm-field-notes">

                        <div class="dm-notes-heading">

                            <i class="fa-solid fa-file-lines"></i>

                            <span>FIELD NOTES</span>

                        </div>

                        <p>
                            Observe Everything.
                            Trust Nothing.
                            Question Everything.
                        </p>

                        <div class="dm-notes-decoration">
                            <i class="fa-solid fa-fingerprint"></i>
                            <span>EVERY CLUE MATTERS</span>
                        </div>

                    </div>


                    <!-- SIDEBAR BOTTOM -->
                    <div class="dm-sidebar-bottom">

                        <div class="dm-sidebar-system-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <div class="dm-sidebar-system-info">

                            <span>SECURITY STATUS</span>

                            <strong>
                                <span class="dm-status-indicator"></span>
                                SYSTEM SECURE
                            </strong>

                        </div>

                    </div>


                    <!-- LOGOUT -->
                    <a href="<%= ResolveUrl("~/Chief-Detective_Module/Chief-Detective_Logout.aspx") %>"
                        class="dm-logout">

                        <i class="fa-solid fa-right-from-bracket"></i>

                        <span>Logout</span>

                    </a>

                </aside>


                <!-- =================================
                     MAIN CONTENT
                ================================== -->

                <main class="dm-main">

                    <div class="dm-content-wrapper">

                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1"
                            runat="server">
                        </asp:ContentPlaceHolder>

                    </div>

                </main>


            </div>


            <!-- =====================================
                 FOOTER
            ====================================== -->

            <footer class="dm-footer">

                <div class="dm-footer-left">

                    <i class="fa-solid fa-fingerprint"></i>

                    <span>
                        MYSTERIOUS CASE FILES
                    </span>

                </div>


                <div class="dm-footer-center">

                    <span>
                        © <%= DateTime.Now.Year %>
                        Mysterious Case Files
                    </span>

                </div>


                <div class="dm-footer-right">

                    <span class="dm-footer-status-dot"></span>

                    <span>SECURE INVESTIGATION SYSTEM</span>

                </div>

            </footer>


        </div>

    </form>

</body>

</html>
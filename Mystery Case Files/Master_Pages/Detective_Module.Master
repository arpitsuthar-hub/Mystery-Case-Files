<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeBehind="Detective_Module.Master.cs"
    Inherits="Mystery_Case_Files.Master_Pages.Detective_Master" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#080b0e" />

    <title>
        <asp:ContentPlaceHolder
            ID="TitleContent"
            runat="server">
            Mysterious Case Files | Detective Module
        </asp:ContentPlaceHolder>
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin="anonymous" />

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="<%= ResolveUrl("~/CSS/Master/Detective_Module.css") %>"
          rel="stylesheet"
          type="text/css" />

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body class="detective-module-page">

    <form id="form1" runat="server">

        <!-- =========================================
             FULL-PAGE BACKGROUND
        ========================================== -->

        <div class="detective-page-background"
             aria-hidden="true">
        </div>


        <!-- =========================================
             PAGE LAYOUT
        ========================================== -->

        <div class="detective-page-layout">

            <!-- =========================================
                 DETECTIVE HEADER
            ========================================== -->

            <header class="detective-header">

                <div class="header-inner">

                    <a class="brand"
                       href="<%= ResolveUrl("~/Detective_Module/Home_Detective.aspx") %>"
                       aria-label="Mysterious Case Files home">

                        <span class="brand-icon">
                            <i class="fa-solid fa-user-secret"
                               aria-hidden="true"></i>
                        </span>

                        <span class="brand-text">

                            <span class="brand-small">
                                MYSTERIOUS CASE FILES
                            </span>

                            <span class="brand-title">
                                DETECTIVE UNIT
                            </span>

                        </span>

                    </a>

                    <div class="header-status">

                        <span class="status-dot"
                              aria-hidden="true">
                        </span>

                        <span class="status-label">
                            INVESTIGATION SYSTEM
                        </span>

                        <span class="status-value">
                            ONLINE
                        </span>

                    </div>

                </div>

            </header>


            <!-- =========================================
                 NAVIGATION
            ========================================== -->

            <nav class="detective-nav"
                 aria-label="Detective navigation">

                <div class="nav-inner">

                    <a class="nav-link"
                       href="<%= ResolveUrl("~/Detective_Module/Dashboard_Detective.aspx") %>">

                        <i class="fa-solid fa-gauge-high"
                           aria-hidden="true"></i>

                        <span>Dashboard</span>

                    </a>

                    <a class="nav-link"
                       href="<%= ResolveUrl("~/Detective_Module/AddNew_Detective.aspx") %>">

                        <i class="fa-solid fa-user-plus"
                           aria-hidden="true"></i>

                        <span>Register Detective</span>

                    </a>

                    <a class="nav-link"
                       href="<%= ResolveUrl("~/Detective_Module/Search_Detective.aspx") %>">

                        <i class="fa-solid fa-magnifying-glass"
                           aria-hidden="true"></i>

                        <span>Search Detective</span>

                    </a>

                    <a class="nav-link"
                       href="<%= ResolveUrl("~/Detective_Module/All_Detective.aspx") %>">

                        <i class="fa-solid fa-users"
                           aria-hidden="true"></i>

                        <span>Detective Directory</span>

                    </a>

                    <span class="nav-spacer"></span>

                    <a class="nav-link nav-logout"
                       href="<%= ResolveUrl("~/Chief-Detective_Module/Chief-Detective_Logout.aspx") %>">

                        <i class="fa-solid fa-right-from-bracket"
                           aria-hidden="true"></i>

                        <span>Logout</span>

                    </a>

                </div>

            </nav>


            <!-- =========================================
                 MAIN CONTENT
            ========================================== -->

            <main class="detective-main">

                <asp:ContentPlaceHolder
                    ID="ContentPlaceHolder1"
                    runat="server">
                </asp:ContentPlaceHolder>

            </main>


            <!-- =========================================
                 MASTER PAGE FOOTER
            ========================================== -->

            <footer class="detective-footer">

                <div class="footer-inner">

                    <div class="footer-brand">

                        <i class="fa-solid fa-fingerprint"
                           aria-hidden="true"></i>

                        <span>MYSTERIOUS CASE FILES</span>

                    </div>

                    <p class="footer-copyright">
                        &copy; <%: DateTime.Now.Year %>
                        Mysterious Case Files.
                        All rights reserved.
                    </p>

                    <div class="footer-status">

                        <span class="footer-status-dot"
                              aria-hidden="true">
                        </span>

                        <span>SECURE SYSTEM</span>

                    </div>

                </div>

            </footer>

        </div>

    </form>

</body>
</html>
